# Caddy gets and renews a free Let's Encrypt certificate for $DOMAIN
# automatically, redirects http -> https, and forwards to the app.
# No domain yet? Use <droplet-ip>.sslip.io (e.g. 203-0-113-10.sslip.io) —
# it resolves to your IP and works with Let's Encrypt.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
	# Caregiver documents / fax uploads may be larger than the default.
	request_body {
		max_size 25MB
	}
	log {
		output stdout
		format console
	}
}
