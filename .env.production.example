# ===========================================================================
# Athleone — production settings. Copy to .env.production and fill in.
# Never commit the real file. Generate secrets with: openssl rand -hex 32
# ===========================================================================

# --- Server (read by docker compose) ---------------------------------------
# The address Caddy gets an HTTPS certificate for. No domain yet? Use your
# droplet's IP with dashes + .sslip.io, e.g. 203-0-113-10.sslip.io
DOMAIN=203-0-113-10.sslip.io
# Password for the bundled Postgres (only the app can reach it).
POSTGRES_PASSWORD=

# --- Required --------------------------------------------------------------
# Signs sign-in sessions. 64 random hex characters.
SESSION_SECRET=
# Encrypts each agency's DocuSign / EVV credentials in the database.
# 64 hex characters. KEEP A COPY SOMEWHERE SAFE — if it's lost, saved
# DocuSign/EVV credentials can't be decrypted and must be re-entered.
EVV_CREDENTIALS_KEY=
# The public address people use, with https://. Used for links in emails
# and texts and to verify Twilio/DocuSign webhooks.
APP_BASE_URL=https://app.example.com

# DATABASE_URL is set by docker-compose.yml (the bundled Postgres). If you
# use DigitalOcean Managed Postgres instead, set it here (it ends in
# ?sslmode=require) and remove the db service from docker-compose.yml.
# DATABASE_URL=postgresql://doadmin:PASSWORD@db-xxxx.db.ondigitalocean.com:25060/defaultdb?sslmode=require
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# --- Email (optional — without it, messages are only recorded) -------------
# EMAIL_PROVIDER: log | smtp | sendgrid | postmark | resend
EMAIL_PROVIDER=log
EMAIL_FROM="Athleone <no-reply@yourdomain.com>"
# EMAIL_REPLY_TO=office@yourdomain.com
# SENDGRID_API_KEY=
# POSTMARK_SERVER_TOKEN=
# RESEND_API_KEY=
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Text messages (optional) -------------------------------------------------
# SMS_PROVIDER: log | twilio
SMS_PROVIDER=log
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15125550100
# or: TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Put the actual message text in new-message notices (default: off, so no
# health information travels by SMS/email).
# NOTIFY_INCLUDE_MESSAGE_TEXT=false

# --- Fax Inbox: reading faxes (see docs/FAX-INTAKE.md) ----------------------
# DOCAI_PROVIDER: demo (typed PDFs only, no account) | google
DOCAI_PROVIDER=demo
# GOOGLE_CLOUD_PROJECT=your-project-id
# DOCAI_LOCATION=us
# DOCAI_PROCESSOR_ID=
# Off Google Cloud, a service-account key (as JSON text, or a file path):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/docai.json

# Where fax files are kept: local (a Docker volume) | gcs (required on Cloud Run)
STORAGE_DRIVER=local
# GCS_BUCKET=athleone-faxes-yourproject

# --- Only for a quick demo WITHOUT https ------------------------------------
# COOKIE_SECURE=false
